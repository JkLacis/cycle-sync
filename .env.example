# Copy to .env (same folder) and fill in. .env is gitignored — never commit it.

# Which AI writes the coach's answers: gemini (default, free tier) or claude (paid credits).
COACH_PROVIDER=gemini

# Gemini: free key at https://aistudio.google.com → Get API key.
# Free tier: Google may use prompts to improve its products.
GEMINI_API_KEY=

# Claude (only if COACH_PROVIDER=claude): key at https://platform.claude.com/ → API keys.
ANTHROPIC_API_KEY=

# Optional (defaults shown)
# COACH_MODEL=gemini-3.8-flash      # claude-opus-5-5 when COACH_PROVIDER=claude
# COACH_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite  # Gemini: tried in order when busy (minimal thinking)
# COACH_EFFORT=low                  # thinking depth: low / medium / high
# HOST=127.0.0.1
# PORT=8000
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=200
# RATE_LIMIT_GLOBAL_PER_DAY=300          # all users together (protects the free quota)
